{
  "name": "Metrolist",
  "id": "app.miku.metrolist",
  "version": "0.10.0",
  "build": 12,
  "rust": "native",
  "appearance": "dark",
  "icon": "assets/icon.png",
  "theme": "theme.json",
  "locales": [
    "en",
    "zh-CN"
  ],
  "window": {
    "title": "Metrolist · NSH",
    "defaultSize": {
      "width": 1440,
      "height": 940
    },
    "minSize": {
      "width": 340,
      "height": 600
    }
  },
  "capabilities": {
    "network": {
      "hosts": [
        "*"
      ]
    },
    "webview": {
      "hosts": [
        "*"
      ]
    },
    "host": [
      "files.*",
      "auth.*",
      "app.*"
    ],
    "audio": true,
    "process": {
      "env": [
        "SPOTISH_DEMO",
        "SPOTISH_BENCH",
        "METROLIST_SPOTIFY_VISUAL"
      ]
    },
    "picker": true,
    "clipboard": true,
    "statusBar": true,
    "openUrl": {
      "schemes": [
        "https",
        "http"
      ]
    },
    "fs": {
      "read": [
        "${dataDir}"
      ],
      "write": [
        "${dataDir}"
      ]
    }
  },
  "statusBar": {
    "foreground": "light"
  },
  "ios": {
    "infoPlist": {
      "NSAppTransportSecurity": {
        "NSAllowsLocalNetworking": true,
        "NSExceptionDomains": {
          "127.0.0.1": {
            "NSExceptionAllowsInsecureHTTPLoads": true
          }
        }
      },
      "LSApplicationQueriesSchemes": [
        "spotify"
      ]
    }
  },
  "macos": {
    "infoPlist": {
      "NSAppTransportSecurity": {
        "NSAllowsLocalNetworking": true,
        "NSExceptionDomains": {
          "127.0.0.1": {
            "NSExceptionAllowsInsecureHTTPLoads": true
          }
        }
      },
      "NSAudioCaptureUsageDescription": "Metrolist listens to the Spotify music it plays so its visual effects move with the beat. The sound never leaves this Mac."
    }
  },
  "web": {
    "host": "web/host.js",
    "connect": [
      "*"
    ],
    "history": false
  },
  "schemes": [
    "metrolist-spotify"
  ]
}
