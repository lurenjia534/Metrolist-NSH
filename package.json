{
  "name": "metrolist-nsh",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "description": "Metrolist, reimagined in Native Shell for desktop, mobile and the web.",
  "scripts": {
    "dev": "node --use-env-proxy --max-http-header-size=65536 server/dev.mjs",
    "build": "node scripts/build.mjs",
    "check": "node scripts/run-nsh.mjs check",
    "test": "node scripts/run-nsh.mjs test --web-host tests/native-login/host.js",
    "web": "node scripts/run-nsh.mjs run --target web",
    "native": "node scripts/run-native.mjs",
    "linux": "node scripts/run-native.mjs linux"
  }
}
